# Referencia das variaveis esperadas. Os valores reais ficam no Infisical.
# Uso local: infisical run --env=dev -- docker compose up --build

# Banco de Dados (PostgreSQL)
POSTGRES_USER=cloudops_user
POSTGRES_PASSWORD=<DEFINIR_SENHA_SEGURA>
POSTGRES_DB=loja_roupas
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend (Express + TypeScript)
PORT=3001
# Porta interna das metricas Prometheus (nao expor publicamente).
METRICS_PORT=9464
LOG_LEVEL=info
# Uso manual (fora do Docker): host localhost. O docker-compose monta a URL com host "postgres".
DATABASE_URL=postgresql://cloudops_user:<DEFINIR_SENHA_SEGURA>@localhost:5432/loja_roupas
CORS_ORIGIN=http://localhost:3000

# Autenticação Admin e JWT
ADMIN_EMAIL=admin@loja.com
ADMIN_PASSWORD=<DEFINIR_SENHA_ADMIN>
JWT_ACCESS_SECRET=<DEFINIR_SEGREDO_ACCESS_JWT>
JWT_REFRESH_SECRET=<DEFINIR_SEGREDO_REFRESH_JWT>

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Observabilidade (Grafana)
GRAFANA_ADMIN_PASSWORD=<DEFINIR_SENHA_FORTE_GRAFANA>
